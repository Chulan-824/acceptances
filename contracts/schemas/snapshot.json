{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://acceptances.local/schemas/snapshot.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "kind": {
      "const": "acceptance_snapshot"
    },
    "projectId": {
      "$ref": "common.json#/$defs/id"
    },
    "campaignId": {
      "$ref": "common.json#/$defs/id"
    },
    "planRef": {
      "$ref": "common.json#/$defs/documentRef"
    },
    "targetRef": {
      "$ref": "common.json#/$defs/documentRef"
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "common.json#/$defs/snapshotItem"
      }
    },
    "readiness": {
      "type": "string",
      "enum": ["ready", "not_ready"]
    },
    "selectionRefs": {
      "type": "array",
      "items": {
        "$ref": "common.json#/$defs/id"
      }
    },
    "adoptedEvaluationRefs": {
      "type": "array",
      "items": {
        "$ref": "common.json#/$defs/evaluationRef"
      }
    }
  },
  "required": [
    "schemaVersion",
    "kind",
    "projectId",
    "campaignId",
    "planRef",
    "targetRef",
    "items",
    "readiness",
    "selectionRefs",
    "adoptedEvaluationRefs"
  ]
}
