{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://acceptances.local/schemas/evaluation.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "kind": {
      "const": "evaluation"
    },
    "id": {
      "$ref": "common.json#/$defs/id"
    },
    "projectId": {
      "$ref": "common.json#/$defs/id"
    },
    "revisionRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "runId": {
          "$ref": "common.json#/$defs/id"
        },
        "revisionId": {
          "$ref": "common.json#/$defs/id"
        },
        "reportSha256": {
          "$ref": "common.json#/$defs/digest"
        },
        "manifestSha256": {
          "$ref": "common.json#/$defs/digest"
        }
      },
      "required": ["runId", "revisionId", "reportSha256", "manifestSha256"]
    },
    "rulesetVersion": {
      "const": "1.0.0"
    },
    "evaluatedAt": {
      "$ref": "common.json#/$defs/timestamp"
    },
    "identityStatus": {
      "type": "string",
      "enum": ["matched", "unverified", "mismatched"]
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "resultId": {
            "$ref": "common.json#/$defs/id"
          },
          "outcome": {
            "type": "string",
            "enum": [
              "passed",
              "failed",
              "flaky",
              "blocked",
              "skipped",
              "not-run"
            ]
          },
          "eligible": {
            "type": "boolean"
          },
          "checks": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "checkItemId": {
                  "$ref": "common.json#/$defs/id"
                },
                "status": {
                  "type": "string",
                  "enum": ["satisfied", "unsatisfied", "unknown", "invalid"]
                },
                "codes": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "assetIds": {
                  "type": "array",
                  "items": {
                    "$ref": "common.json#/$defs/id"
                  }
                }
              },
              "required": ["checkItemId", "status", "codes", "assetIds"]
            }
          }
        },
        "required": ["resultId", "outcome", "eligible", "checks"]
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "$ref": "common.json#/$defs/diagnostic"
      }
    },
    "extensions": {
      "$ref": "common.json#/$defs/extensions"
    }
  },
  "required": [
    "schemaVersion",
    "kind",
    "id",
    "projectId",
    "revisionRef",
    "rulesetVersion",
    "evaluatedAt",
    "identityStatus",
    "results",
    "diagnostics"
  ]
}
