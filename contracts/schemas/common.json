{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://acceptances.local/schemas/common.json",
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "integer": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "commit": {
      "type": "string",
      "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "text": {
      "type": "string"
    },
    "ref": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "versionId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "documentId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": ["id", "versionId", "documentId", "sha256"]
    },
    "versionRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "versionId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        }
      },
      "required": ["id", "versionId"]
    },
    "documentRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": ["id", "sha256"]
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9.-]*/[^/]+$"
      }
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "evidenceRequirement": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "checkItemId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "allowedKinds": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["image", "video", "audio", "text", "json", "binary"]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "minCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": ["checkItemId", "allowedKinds", "minCount"]
    },
    "revision": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "commit"
            },
            "commit": {
              "type": "string",
              "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"
            }
          },
          "required": ["kind", "commit"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "dirty"
            },
            "baseCommit": {
              "type": "string",
              "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"
            },
            "fingerprint": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "scopeDigest": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "complete": {
              "type": "boolean"
            }
          },
          "required": [
            "kind",
            "baseCommit",
            "fingerprint",
            "scopeDigest",
            "complete"
          ]
        }
      ]
    },
    "repositoryRevision": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repositoryId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "revision": {
          "$ref": "#/$defs/revision"
        }
      },
      "required": ["repositoryId", "revision"]
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "include": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "exclude": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "missingInputs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": ["include", "exclude", "missingInputs"]
    },
    "environmentRequirements": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "op": {
                "const": "eq"
              },
              "value": {
                "type": "string"
              }
            },
            "required": ["op", "value"]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "op": {
                "const": "oneOf"
              },
              "stringValues": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1,
                "uniqueItems": true
              }
            },
            "required": ["op", "stringValues"]
          }
        ]
      }
    },
    "selector": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "startMs": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "endMs": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": ["startMs", "endMs"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "lineStart": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "lineEnd": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": ["lineStart", "lineEnd"]
        }
      ]
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "assetId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "description": {
          "type": "string"
        },
        "selector": {
          "$ref": "#/$defs/selector"
        }
      },
      "required": ["assetId", "description"]
    },
    "checkItem": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "description": {
          "type": "string"
        },
        "expected": {
          "type": "string"
        }
      },
      "required": ["id", "description", "expected"]
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "versionId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "title": {
          "type": "string"
        },
        "intent": {
          "type": "string"
        },
        "ownerRepositoryId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "checkItems": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/checkItem"
          },
          "minItems": 1
        },
        "originCampaignId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        }
      },
      "required": [
        "id",
        "versionId",
        "title",
        "intent",
        "ownerRepositoryId",
        "checkItems"
      ]
    },
    "executionDefinition": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "versionId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "caseRef": {
          "$ref": "#/$defs/versionRef"
        },
        "kind": {
          "type": "string",
          "enum": ["agent", "script"]
        },
        "instructions": {
          "type": "string"
        },
        "evidenceRequirements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidenceRequirement"
          }
        },
        "scriptRef": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "repositoryId": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            "commit": {
              "type": "string",
              "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"
            },
            "path": {
              "$ref": "#/$defs/path"
            }
          },
          "required": ["repositoryId", "commit", "path"]
        }
      },
      "required": [
        "id",
        "versionId",
        "caseRef",
        "kind",
        "instructions",
        "evidenceRequirements"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "script"
              }
            }
          },
          "then": {
            "required": ["scriptRef"]
          },
          "else": {
            "not": {
              "required": ["scriptRef"]
            }
          }
        }
      ]
    },
    "planItem": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "caseRef": {
          "$ref": "#/$defs/ref"
        },
        "executionRef": {
          "$ref": "#/$defs/ref"
        },
        "required": {
          "type": "boolean"
        },
        "environmentRequirements": {
          "$ref": "#/$defs/environmentRequirements"
        },
        "evidenceRequirements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidenceRequirement"
          }
        },
        "changeReason": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "caseRef",
        "executionRef",
        "required",
        "environmentRequirements",
        "evidenceRequirements"
      ]
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "externalTaskId": {
          "type": "string"
        }
      },
      "required": ["name", "version"]
    },
    "sourceSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repositoryId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "baseCommit": {
          "type": "string",
          "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"
        },
        "dirty": {
          "type": "boolean"
        },
        "scope": {
          "$ref": "#/$defs/scope"
        },
        "fingerprint": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "complete": {
          "type": "boolean"
        }
      },
      "required": [
        "repositoryId",
        "baseCommit",
        "dirty",
        "scope",
        "fingerprint",
        "complete"
      ]
    },
    "buildObservation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "method": {
          "type": "string",
          "enum": ["version_endpoint", "build_record", "deployment_metadata"]
        },
        "observedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "instanceId": {
          "type": "string"
        },
        "repositoryIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "assetIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          }
        }
      },
      "required": [
        "id",
        "method",
        "observedAt",
        "instanceId",
        "repositoryIds",
        "assetIds"
      ]
    },
    "observedBuild": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "type": "string",
          "enum": ["matched", "unverified", "mismatched"]
        },
        "repositories": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/repositoryRevision"
          }
        },
        "observations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/buildObservation"
          }
        },
        "changes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "observedAt": {
                "type": "string",
                "format": "date-time",
                "pattern": "Z$"
              },
              "description": {
                "type": "string"
              },
              "affectedResultIds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                }
              }
            },
            "required": ["observedAt", "description", "affectedResultIds"]
          }
        }
      },
      "required": ["status", "repositories", "observations", "changes"]
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "checkItemId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "verdict": {
          "type": "string",
          "enum": ["passed", "failed", "unknown"]
        },
        "actual": {
          "type": "string"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        }
      },
      "required": ["checkItemId", "verdict", "actual", "evidence"]
    },
    "attempt": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "ordinal": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "startedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "endedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "outcome": {
          "type": "string",
          "enum": ["passed", "failed", "blocked", "skipped"]
        },
        "observations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/observation"
          }
        }
      },
      "required": [
        "id",
        "ordinal",
        "startedAt",
        "endedAt",
        "outcome",
        "observations"
      ]
    },
    "resultRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "runId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "revisionId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "resultId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        }
      },
      "required": ["runId", "revisionId", "resultId"]
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "planItemId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "caseRef": {
          "$ref": "#/$defs/versionRef"
        },
        "executionRef": {
          "$ref": "#/$defs/versionRef"
        },
        "actualObservedRef": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "outcome": {
          "type": "string",
          "enum": ["passed", "failed", "flaky", "blocked", "skipped", "not-run"]
        },
        "attempts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/attempt"
          }
        },
        "supersedes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/resultRef"
          }
        },
        "missingEvidence": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "checkItemId": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
              },
              "reason": {
                "type": "string"
              }
            },
            "required": ["checkItemId", "reason"]
          }
        }
      },
      "required": [
        "id",
        "planItemId",
        "caseRef",
        "executionRef",
        "actualObservedRef",
        "outcome",
        "attempts",
        "supersedes",
        "missingEvidence"
      ]
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string"
        },
        "pointer": {
          "type": "string"
        },
        "resourceId": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      },
      "required": ["code", "message"]
    },
    "evaluationRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "rulesetVersion": {
          "const": "1.0.0"
        }
      },
      "required": ["id", "sha256", "rulesetVersion"]
    },
    "snapshotItem": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "planItemId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "required": {
          "type": "boolean"
        },
        "selectionStatus": {
          "type": "string",
          "enum": ["selected", "missing", "conflict"]
        },
        "resultRef": {
          "anyOf": [
            {
              "$ref": "#/$defs/resultRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "evaluationRef": {
          "anyOf": [
            {
              "$ref": "#/$defs/evaluationRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "eligibility": {
          "type": "boolean"
        },
        "codes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "candidateRefs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/resultRef"
          }
        }
      },
      "required": [
        "planItemId",
        "required",
        "selectionStatus",
        "resultRef",
        "evaluationRef",
        "eligibility",
        "codes"
      ]
    }
  }
}
