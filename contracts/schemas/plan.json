{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://acceptances.local/schemas/plan.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "kind": {
      "const": "plan"
    },
    "id": {
      "$ref": "common.json#/$defs/id"
    },
    "projectId": {
      "$ref": "common.json#/$defs/id"
    },
    "campaignId": {
      "$ref": "common.json#/$defs/id"
    },
    "previousPlanId": {
      "anyOf": [
        {
          "$ref": "common.json#/$defs/id"
        },
        {
          "type": "null"
        }
      ]
    },
    "changeReason": {
      "type": "string",
      "minLength": 1
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "common.json#/$defs/planItem"
      },
      "minItems": 1,
      "contains": {
        "type": "object",
        "required": ["required"],
        "properties": {
          "required": {
            "const": true
          }
        }
      }
    },
    "extensions": {
      "$ref": "common.json#/$defs/extensions"
    }
  },
  "required": [
    "schemaVersion",
    "kind",
    "id",
    "projectId",
    "campaignId",
    "previousPlanId",
    "changeReason",
    "items"
  ]
}
