{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://acceptances.local/schemas/manifest.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "kind": {
      "const": "manifest"
    },
    "id": {
      "$ref": "common.json#/$defs/id"
    },
    "projectId": {
      "$ref": "common.json#/$defs/id"
    },
    "runId": {
      "$ref": "common.json#/$defs/id"
    },
    "report": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "const": "report.json"
        },
        "size": {
          "$ref": "common.json#/$defs/integer"
        },
        "sha256": {
          "$ref": "common.json#/$defs/digest"
        }
      },
      "required": ["path", "size", "sha256"]
    },
    "documents": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "common.json#/$defs/id"
          },
          "kind": {
            "type": "string",
            "enum": ["definitions", "plan", "target"]
          },
          "sha256": {
            "$ref": "common.json#/$defs/digest"
          }
        },
        "required": ["id", "kind", "sha256"]
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "common.json#/$defs/id"
          },
          "path": {
            "$ref": "common.json#/$defs/path"
          },
          "size": {
            "$ref": "common.json#/$defs/integer"
          },
          "sha256": {
            "$ref": "common.json#/$defs/digest"
          },
          "kind": {
            "type": "string",
            "enum": ["image", "video", "audio", "text", "json", "binary"]
          },
          "mediaType": {
            "type": "string"
          }
        },
        "required": ["id", "path", "size", "sha256", "kind", "mediaType"]
      },
      "maxItems": 2000
    },
    "extensions": {
      "$ref": "common.json#/$defs/extensions"
    }
  },
  "required": [
    "schemaVersion",
    "kind",
    "id",
    "projectId",
    "runId",
    "report",
    "documents",
    "assets"
  ]
}
