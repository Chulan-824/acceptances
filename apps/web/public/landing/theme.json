{
  "$schema": "https://acceptances.dev/schemas/theme.v1.json",
  "name": "Modern Slate",
  "version": "1.0.0",
  "preset": "modern-slate",
  "label": "现代工程精密风 (Modern Slate & Precision Pine)",
  "reference": "Linear / Biome / Turbo / Cloudflare",
  "description": "专为本地优先研发验收工具设计。中性底盘基于 Tailwind Slate，品牌主色采用钛墨深黑，语义状态采用松柏墨翠、琥珀暖黄与石榴朱红，视觉降噪极致且责任清晰。",
  "meta": {
    "author": "Acceptances Core Team",
    "createdAt": "2026-10-10",
    "updatedAt": "2026-10-10",
    "license": "MIT"
  },
  "tokens": {
    "colors": {
      "neutral": {
        "canvas": {
          "value": "#f8fafc",
          "tw": "slate-50",
          "desc": "全局画布背景底色，微冷蓝灰防刺眼"
        },
        "surface": {
          "value": "#ffffff",
          "tw": "white",
          "desc": "卡片、抽屉与主要交互容器背景"
        },
        "surfaceSubtle": {
          "value": "#f1f5f9",
          "tw": "slate-100",
          "desc": "二级背景、代码块背景、搜索条底色"
        },
        "surfaceHover": {
          "value": "#f8fafc",
          "tw": "slate-50",
          "desc": "列表项与卡片 Hover 响应底色"
        },
        "border": {
          "value": "#e2e8f0",
          "tw": "slate-200",
          "desc": "通用微弱边框分界线"
        },
        "borderDark": {
          "value": "#cbd5e1",
          "tw": "slate-300",
          "desc": "高反差或悬停态边框线"
        }
      },
      "typography": {
        "fg": {
          "value": "#0f172a",
          "tw": "slate-900",
          "desc": "正文主标题、主内容文本"
        },
        "fgSecondary": {
          "value": "#334155",
          "tw": "slate-700",
          "desc": "次级文本、表单标签、导航链接"
        },
        "muted": {
          "value": "#64748b",
          "tw": "slate-500",
          "desc": "辅助信息、时间戳、说明性副文本"
        },
        "subtle": {
          "value": "#94a3b8",
          "tw": "slate-400",
          "desc": "占位符、失效文本、最弱级说明"
        }
      },
      "brand": {
        "primary": {
          "value": "#0f172a",
          "tw": "slate-900",
          "desc": "主品牌识别与主要操作按钮背景（钛墨黑）"
        },
        "primaryHover": {
          "value": "#1e293b",
          "tw": "slate-800",
          "desc": "主操作按钮 Hover 响应色"
        },
        "primaryFg": {
          "value": "#ffffff",
          "tw": "white",
          "desc": "主按钮文本反白前景色"
        },
        "topnavBg": {
          "value": "rgba(248, 250, 252, 0.88)",
          "tw": "backdrop-blur",
          "desc": "顶栏亚克力毛玻璃半透明底色"
        }
      },
      "semantic": {
        "pass": {
          "base": {
            "value": "#059669",
            "tw": "emerald-600",
            "desc": "验证通过、放行标识、健康指示"
          },
          "soft": {
            "value": "#ecfdf5",
            "tw": "emerald-50",
            "desc": "通过状态徽章柔和背景"
          },
          "border": {
            "value": "#a7f3d0",
            "tw": "emerald-200",
            "desc": "通过状态徽章边框"
          },
          "dark": {
            "value": "#047857",
            "tw": "emerald-700",
            "desc": "通过状态深色文字"
          }
        },
        "pending": {
          "base": {
            "value": "#d97706",
            "tw": "amber-600",
            "desc": "待人工验收、警告提示、进行中"
          },
          "soft": {
            "value": "#fffbeb",
            "tw": "amber-50",
            "desc": "待验状态徽章柔和背景"
          },
          "border": {
            "value": "#fde68a",
            "tw": "amber-200",
            "desc": "待验状态徽章边框"
          },
          "dark": {
            "value": "#b45309",
            "tw": "amber-700",
            "desc": "待验状态深色文字"
          }
        },
        "reject": {
          "base": {
            "value": "#e11d48",
            "tw": "rose-600",
            "desc": "验证阻断、拒绝验收、核心错误"
          },
          "soft": {
            "value": "#fff1f2",
            "tw": "rose-50",
            "desc": "阻断状态徽章柔和背景"
          },
          "border": {
            "value": "#fecdd3",
            "tw": "rose-200",
            "desc": "阻断状态徽章边框"
          },
          "dark": {
            "value": "#be123c",
            "tw": "rose-700",
            "desc": "阻断状态深色文字"
          }
        }
      }
    },
    "typography": {
      "fontFamily": {
        "sans": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei\", sans-serif",
        "mono": "ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace"
      }
    },
    "borderRadius": {
      "sm": "4px",
      "DEFAULT": "6px",
      "md": "8px",
      "lg": "12px",
      "full": "9999px"
    },
    "boxShadow": {
      "subtle": "0 1px 2px 0 rgba(15, 23, 42, 0.04)",
      "card": "0 1px 3px 0 rgba(15, 23, 42, 0.06), 0 1px 2px -1px rgba(15, 23, 42, 0.06)",
      "dropdown": "0 10px 15px -3px rgba(15, 23, 42, 0.08), 0 4px 6px -4px rgba(15, 23, 42, 0.04)"
    }
  },
  "mcp": {
    "server": "acceptances-design-mcp",
    "recommendedTool": "init_theme_preset",
    "description": "通过 MCP (Model Context Protocol) 协议向任意目标前端项目快速注入并初始化该套主题配置",
    "sampleCall": {
      "tool": "init_theme_preset",
      "args": {
        "preset": "modern-slate",
        "target": "./frontend",
        "framework": "tailwind-v3",
        "includeCssVariables": true,
        "injectFiles": ["tailwind.config.js", "src/styles/tokens.css"]
      }
    },
    "quickPrompt": "请通过 MCP 工具 `init_theme_preset` 将 Acceptances 的 Modern Slate (现代工程精密风) 主题配置写入当前项目，配置包含 Slate 灰阶、钛墨深黑主色与 Emerald/Amber/Rose 状态色定义。",
    "cliCommand": "npx acceptances theme init --preset modern-slate"
  }
}
